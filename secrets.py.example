# WiFi credentials for the Badger 2350.
#
# Copy this file to the ROOT of the badge's disk (i.e. /system/secrets.py on
# the device — NOT inside the app folder), fill in your details, and never
# commit the filled-in version to version control.
#
# The Badger's radio is 2.4 GHz only.

WIFI_SSID = "your-network-name"
WIFI_PASSWORD = "your-password"
REGION = "eu"  # Options are us, cuba, eu, moldova, lebanon, egypt, chile, australia, nz
